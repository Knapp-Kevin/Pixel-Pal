{
  "name": "pixel-pals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@pixel-pals/tablet",
    "build": "npm run build --workspace=@pixel-pals/tablet",
    "preview": "npm run preview --workspace=@pixel-pals/tablet",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "verify:artifacts": "node scripts/verify-build-artifacts.mjs apps/tablet/dist",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "verify:viewports": "node scripts/verify-tablet-viewports.mjs",
    "verify:suspension": "node scripts/verify-tablet-suspension.mjs",
    "verify:adventures": "node scripts/verify-illustrated-adventures.mjs",
    "verify:worlds": "node scripts/verify-multiple-worlds.mjs",
    "verify:performance": "node scripts/verify-emulated-tablet-performance.mjs",
    "verify:traits-lab": "node scripts/verify-traits-lab.mjs",
    "verify:art-plan": "node scripts/verify-production-art.mjs",
    "verify:production-art": "node scripts/verify-production-art.mjs --release",
    "verify:art-reviews": "node scripts/verify-human-art-reviews.mjs",
    "generate:art-registry": "node scripts/generate-production-art-registry.mjs",
    "verify:art-registry": "node scripts/generate-production-art-registry.mjs --check",
    "generate:art-review": "node scripts/generate-art-review-report.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
